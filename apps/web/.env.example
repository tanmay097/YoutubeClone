# MongoDB Atlas (free tier) connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vidora

# Long random string: `openssl rand -base64 32`
JWT_SECRET=change-me

# ImageKit (Dashboard → Developer options)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx

# Where uploaded videos are stored (defaults to <repo>/uploads)
# UPLOAD_DIR=/absolute/path/to/uploads
